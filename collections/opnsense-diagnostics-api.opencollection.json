{
  "opencollection": "1.0.0",
  "info": {
    "name": "OPNsense REST Core Diagnostics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Diagnostics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List interface names",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/api/diagnostics/interface/getInterfaceNames"
          },
          "docs": "Returns the list of available network interface names."
        }
      ]
    }
  ],
  "bundled": true
}